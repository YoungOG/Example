<h2 class="page-header">Account Login</h2>
<form method="post" action="/users/login">
    <div>
        <label>Username</label>
        <input class="form-control" name="username" placeholder="Username" maxlength="16">
    </div>

    <div class="form-group">
        <label>Password</label>
        <input type="password" class="form-control" name="password" placeholder="Password" maxlength="32">
    </div>

    <button title="submit" class="btn btn-default">Submit</button>
</form>